{
  "name": "suji",
  "private": true,
  "version": "1.0.0",
  "author": "Orion D. Scales",
  "company": "Olufona Group",
  "type": "module",
  "scripts": {
    "create-admin": "node scripts/create-admin.js",
    "init-categories": "node scripts/init-categories.js",
    "dedup:suppliers": "node scripts/dedup-suppliers.js",
    "dedup:suppliers:prod": "node scripts/dedup-suppliers.js --prod",
    "dedup:suppliers:run": "node scripts/dedup-suppliers.js --prod --execute",
    "migrate:products": "npx convex run productMigration:migrateAllProductsCLI --prod",
    "migrate:dry-run": "echo 'Dry run not available - use migrate:products directly'",
    "migrate:complete": "npx convex run productMigration:migrateAllProductsCLI --prod",
    "migrate:full": "npx convex run productMigration:runFullMigrationCLI '{\"defaultLanguage\": \"en\", \"productBatchSize\": 100, \"matchBatchSize\": 50, \"autoApproveHighConfidence\": true}' --prod",
    "migrate:continue": "node scripts/migrate-continue.js",
    "typesense:init": "node scripts/typesense-init.js",
    "migrate:matches": "node scripts/migrate-matches.js",
    "migrate:matches:batch": "node scripts/migrate-matches-batch.js",
    "migrate:matches:alt": "node scripts/migrate-matches-alt.js",
    "migrate:status": "node scripts/migration-status.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@clerk/clerk-js": "^5.103.1",
    "@clerk/clerk-react": "^5.53.4",
    "@convex-dev/migrations": "^0.3.1",
    "@tanstack/react-query": "^5.90.8",
    "convex": "^1.32.0",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.577.0",
    "mapbox-gl": "^3.18.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.6.0",
    "react-map-gl": "^8.1.0",
    "react-router-dom": "^7.6.3",
    "recharts": "3.2.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "@vitest/ui": "^4.0.17",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.9.18",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "source-map": "^0.7.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "unplugin-auto-import": "^19.3.0",
    "vite": "^7.0.3",
    "vitest": "^4.0.17"
  }
}
